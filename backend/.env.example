# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL Database Configuration
# Optional managed connection string; when set, it takes precedence over DB_*.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=study_connect_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# JWT Authentication
JWT_SECRET=replace-with-a-random-secret-before-production
JWT_EXPIRATION=7d

# Email delivery: configure either Resend (domain-authenticated sender) or Brevo.
RESEND_API_KEY=
BREVO_API_KEY=
# The sender must be verified with the configured provider.
MAIL_FROM=StudyConnect <your-verified-sender@example.com>

# Throttling / Rate Limiting (1 request per 60s for OTP resends)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# CORS
CORS_ORIGIN=http://localhost:5173
